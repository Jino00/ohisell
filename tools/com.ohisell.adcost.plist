<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: 쿠팡 광고비 페처를 "상주 poll 데몬"으로 실행 (Jino Mac). -->
<!-- 버튼 트리거 방식: 평소엔 15s마다 prod에 갱신요청만 확인(창 안 뜸), -->
<!-- 대시보드 '광고비 갱신' 버튼을 누른 경우에만 headful fetch(창 ~20초). -->
<!-- 설치:  cp tools/com.ohisell.adcost.plist ~/Library/LaunchAgents/ -->
<!--        launchctl unload ~/Library/LaunchAgents/com.ohisell.adcost.plist 2>/dev/null -->
<!--        launchctl load ~/Library/LaunchAgents/com.ohisell.adcost.plist -->
<!-- 경로(python/스크립트)는 설치 전 실제 경로로 치환되어야 함 (README 참조). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ohisell.adcost</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__SCRIPT__</string>
    <string>poll</string>
  </array>
  <!-- 상주 데몬: 죽으면 자동 재시작(crash·네트워크 끊김·Mac sleep 복귀 대비). -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <!-- 재시작 폭주 방지: 비정상 종료 시 최소 10초 후 재기동. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.ohisell_ad_fetcher.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.ohisell_ad_fetcher.launchd.log</string>
</dict>
</plist>
