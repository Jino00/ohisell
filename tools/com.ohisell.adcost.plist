<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: 쿠팡 광고비 로컬 페처를 매시간 실행 (Jino Mac). -->
<!-- 설치:  cp tools/com.ohisell.adcost.plist ~/Library/LaunchAgents/ -->
<!--        launchctl load ~/Library/LaunchAgents/com.ohisell.adcost.plist -->
<!-- 경로(python/스크립트)는 설치 전 실제 경로로 치환되어야 함 (setup.md 참조). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ohisell.adcost</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__SCRIPT__</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.ohisell_ad_fetcher.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.ohisell_ad_fetcher.launchd.log</string>
</dict>
</plist>
