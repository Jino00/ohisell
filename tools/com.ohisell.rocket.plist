<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: 쿠팡 로켓배송(1P) supplier 페처를 "시간예약형"으로 실행 (Jino Mac, 트랙 rocket-1p S3). -->
<!-- Option A(Jino 승인 2026-06-17): 1P 데이터는 느리게 변함(발주 때때로·정산 주 단위) → 상주 poll 대신 -->
<!--   매일 08:00 KST(=Mac 로컬시각) 'run' 1회. 살아있는 전용 Chrome(CDP 9223)에 연결→발주+정산 수집→prod push. -->
<!-- 광고/Wing 데몬과 별도 프로세스·별도 Chrome 프로필(~/.ohisell_supplier_chrome) — 도메인·세션 분리. -->
<!-- 온디맨드 '갱신' 버튼은 S5(프론트)에서 refresh 엔드포인트 3종과 함께 추가. -->
<!-- 설치:  cp tools/com.ohisell.rocket.plist ~/Library/LaunchAgents/ -->
<!--        launchctl unload ~/Library/LaunchAgents/com.ohisell.rocket.plist 2>/dev/null -->
<!--        launchctl load ~/Library/LaunchAgents/com.ohisell.rocket.plist -->
<!-- 즉시 1회 실행(테스트):  launchctl kickstart -k gui/$(id -u)/com.ohisell.rocket -->
<!-- 경로(python/스크립트)는 설치 전 실제 경로로 치환되어야 함. ~/.ohisell_rocket_fetcher.json에 -->
<!-- prod_base_url·ingest_token·vendor_id 설정 필수(없으면 run fail-fast). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ohisell.rocket</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jino/Library/Mobile Documents/com~apple~CloudDocs/1Personal/AI Program/Ohiselling/backend/.venv/bin/python3</string>
    <string>/Users/jino/Library/Mobile Documents/com~apple~CloudDocs/1Personal/AI Program/Ohiselling/tools/rocket_supplier_fetcher.py</string>
    <string>run</string>
  </array>
  <!-- 시간예약형: 매일 08:00(Mac 로컬=KST) 1회 실행. 상주 아님(KeepAlive 없음). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <!-- 로드 시 즉시 실행 안 함(예약 시각에만). -->
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/jino/.ohisell_rocket_fetcher.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jino/.ohisell_rocket_fetcher.launchd.log</string>
</dict>
</plist>
