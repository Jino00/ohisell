<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: Wing 수집용 CDP Chrome(9222)을 상주화 (S5a, 트랙 revenue-wing-truth D-4). -->
<!-- 왜: Wing 판매분석은 Akamai 우회를 위해 실제 Chrome(--remote-debugging-port)에 CDP attach해야 -->
<!--     한다. 이 Chrome이 수동 실행이라 Mac 재부팅/Chrome 종료 시 멈춰(6/15~6/20 5일 정지) -->
<!--     Wing 수집이 중단됐다. launchd가 Chrome 수명을 KeepAlive로 관리 → 무중단. -->
<!-- poll 데몬(com.ohisell.wing)은 connect_over_cdp로 이 Chrome에 attach만 함 → 독립·공존. -->
<!-- supervisor(chrome-supervise)는 Chrome을 포그라운드 자식으로 잡고 block → launchd가 -->
<!--   "프로세스 수명 = Chrome 수명"으로 인식. cmd_chrome(Popen 후 즉시 리턴)과 달라야 함. -->
<!-- 설치:  tools/install_local_runtime.sh 실행(placeholder 치환·bootstrap 자동). -->
<!-- 코드 변경 후 재배포:  launchctl kickstart -k gui/$(id -u)/com.ohisell.wing-chrome -->
<!-- 일시 중지(Chrome 띄우지 않기):  launchctl bootout gui/$(id -u)/com.ohisell.wing-chrome -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ohisell.wing-chrome</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__SCRIPT__</string>
    <string>chrome-supervise</string>
  </array>
  <!-- Chrome이 닫히거나 크래시하면 자동 재기동(무중단 = D-4). -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <!-- 재기동 폭주 방지: 비정상 종료 시 최소 10초 후 재기동. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/jino/.ohisell_wing_chrome.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jino/.ohisell_wing_chrome.launchd.log</string>
</dict>
</plist>
