<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: 오하이테크(1P 로켓배송) 광고 수집용 CDP Chrome(9224)을 상주화 (S3, 트랙 ohitech-ad D-11). -->
<!-- 왜: 오하이테크 광고센터(advertising.coupang.com)는 Akamai 우회를 위해 실제 Chrome -->
<!--     (--remote-debugging-port=9224)에 CDP attach해야 한다. 이 Chrome이 수동 실행이라 -->
<!--     Mac 재부팅/Chrome 종료/세션만료 시 멈춰 광고비 수집이 끊겼다(누락 ~400만원). -->
<!--     launchd가 Chrome 수명을 KeepAlive로 관리 → 무중단. -->
<!-- ★포트 9224 전용(D-11): 9222=WING1(상주), 9223=rocket/wing2 수동 공유. 9223에 상주화하면 -->
<!--     rocket/wing2와 영구 충돌(엉뚱한 세션 attach→오벤더 push) → 오하이테크 전용 9224. -->
<!-- poll 데몬(com.ohisell.ohitech-ad)은 connect_over_cdp로 이 Chrome에 attach만 함 → 독립·공존. -->
<!-- supervisor(chrome-supervise)는 Chrome을 포그라운드 자식으로 잡고 block → launchd가 -->
<!--   "프로세스 수명 = Chrome 수명"으로 인식. cmd_chrome(Popen 후 즉시 리턴)과 달라야 함. -->
<!-- 설치:  tools/install_local_runtime.sh 실행(placeholder 치환·bootstrap 자동). -->
<!-- 코드 변경 후 재배포:  launchctl kickstart -k gui/$(id -u)/com.ohisell.ohitech-chrome -->
<!-- 일시 중지(Chrome 띄우지 않기):  launchctl bootout gui/$(id -u)/com.ohisell.ohitech-chrome -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ohisell.ohitech-chrome</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__SCRIPT__</string>
    <string>chrome-supervise</string>
  </array>
  <!-- Chrome이 닫히거나 크래시하면 자동 재기동(무중단). -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <!-- 재기동 폭주 방지: 비정상 종료 시 최소 10초 후 재기동. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.ohisell_ohitech_chrome.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.ohisell_ohitech_chrome.launchd.log</string>
</dict>
</plist>
